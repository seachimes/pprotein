{
  "name": "view",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build",
    "serve": "vp preview",
    "lint": "vp lint -c .oxlintrc.json src",
    "fmt": "vp fmt -c .oxfmtrc.json src",
    "fix": "vp lint -c .oxlintrc.json --fix src && vp fmt -c .oxfmtrc.json src",
    "check": "vp fmt -c .oxfmtrc.json --check src && vp lint -c .oxlintrc.json src && vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.0.17",
    "papaparse": "^5.4.1",
    "vue": "^3.3.8",
    "vue-router": "^4.2.5",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.11",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.3.8",
    "sass": "^1.69.5",
    "typescript": "~5.9",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  },
  "packageManager": "pnpm@11.8.0"
}
